# Copiar a .env.local y ajustar.
# El frontend consume EXCLUSIVAMENTE la API REST de FastAPI (JWT Bearer).
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1

# true = datos de ejemplo del diseño sin backend (8 hospitales, 3 tramos, expedientes 65f…001 y …002).
# El modo real (false) es el predeterminado.
NEXT_PUBLIC_USE_MOCKS=false
